{
  "schema": "ziprunner.zr/v1",
  "project_key": "ziprunner-spec",
  "label": "ziprunner-spec",
  "match": [
    "ziprunner-spec*.zip",
    "ziprunner-spec*.zip"
  ],
  "command_subdir": ".",
  "stop": [],
  "stop_ports": [],
  "build": [
    "echo Configure build commands for ziprunner-spec"
  ],
  "start": [],
  "build_window": "hidden",
  "start_window": "managed",
  "delete_missing": false,
  "strip_single_root": true,
  "protected_paths": [
    ".git/**",
    ".env",
    ".env.*",
    "*.pem",
    "*.key",
    "*.pfx",
    "*.crt",
    "private/**",
    "**/private/**",
    "server-state/**",
    "**/server-state/**",
    "runtime/**",
    "**/runtime/**",
    "data/**",
    "**/data/**",
    "storage/**",
    "**/storage/**",
    "uploads/**",
    "**/uploads/**",
    "packages/**",
    "**/packages/**",
    "public-index/**",
    "**/public-index/**",
    "logs/**",
    "**/logs/**",
    "chrome-profile/**",
    "target/**",
    "**/target/**",
    "node_modules/**",
    "dist/**",
    "build/**"
  ],
  "require_clean_git_before_overlay": false,
  "mechanisms_require_build_success": true,
  "repository": {
    "url": "",
    "branch": "main",
    "allow_push": false
  },
  "git": {
    "enabled": false,
    "branch": "main",
    "commit_message": "Release {project} {version}",
    "source_paths": [
      "."
    ],
    "exclude_paths": [
      ".env",
      ".env.*",
      "*.pem",
      "*.key",
      "*.pfx",
      "*.crt",
      "private/**",
      "**/private/**",
      "server-state/**",
      "**/server-state/**",
      "runtime/**",
      "**/runtime/**",
      "data/**",
      "**/data/**",
      "storage/**",
      "**/storage/**",
      "uploads/**",
      "**/uploads/**",
      "packages/**",
      "**/packages/**",
      "public-index/**",
      "**/public-index/**",
      "logs/**",
      "**/logs/**",
      "chrome-profile/**",
      "target/**",
      "**/target/**",
      "node_modules/**",
      "dist/**",
      "build/**"
    ],
    "source_publish_overlay_excludes": [
      ".env",
      ".env.*",
      "*.pem",
      "*.key",
      "*.pfx",
      "*.crt",
      "private/**",
      "**/private/**",
      "server-state/**",
      "**/server-state/**",
      "runtime/**",
      "**/runtime/**",
      "data/**",
      "**/data/**",
      "storage/**",
      "**/storage/**",
      "uploads/**",
      "**/uploads/**",
      "packages/**",
      "**/packages/**",
      "public-index/**",
      "**/public-index/**",
      "logs/**",
      "**/logs/**",
      "chrome-profile/**",
      "target/**",
      "**/target/**",
      "node_modules/**",
      "dist/**",
      "build/**"
    ],
    "include_pull": true,
    "include_push": false,
    "include_tag": false,
    "include_github_release": false,
    "include_github_status": false,
    "github_repo": "",
    "github_workflow": ""
  },
  "post_build_mechanisms": [],
  "handoff": {
    "notes": [
      "Read AGENTS.md first for the required project context order.",
      "Read INSTRUCT.md before changing product behavior.",
      "Read DESIGN.adoc before changing architecture, storage, APIs, or release flow.",
      "For automated work, cite the exact governing design section and stop the affected scope when a decision is missing.",
      "Read ENGINEERING_STANDARD.adoc, CODING.md, and TESTING.md before modifying code.",
      "Treat 500 source lines and 80 function lines as review thresholds.",
      "Every bug fix requires a regression test; run focused, full, and fresh-package validation.",
      "Keep data/runtime/private folders out of source publish unless explicitly reviewed.",
      "Keep dangerous release/deploy steps manual and gated.",
      "Include a ZIPRUNNER_HANDOFF v1 block with downloadable artifacts."
    ],
    "exclude_from_source_zip": [
      ".env",
      ".env.*",
      "*.pem",
      "*.key",
      "*.pfx",
      "*.crt",
      "private/**",
      "**/private/**",
      "server-state/**",
      "**/server-state/**",
      "runtime/**",
      "**/runtime/**",
      "data/**",
      "**/data/**",
      "storage/**",
      "**/storage/**",
      "uploads/**",
      "**/uploads/**",
      "packages/**",
      "**/packages/**",
      "public-index/**",
      "**/public-index/**",
      "logs/**",
      "**/logs/**",
      "chrome-profile/**",
      "target/**",
      "**/target/**",
      "node_modules/**",
      "dist/**",
      "build/**"
    ]
  }
}
