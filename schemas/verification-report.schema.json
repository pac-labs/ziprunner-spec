{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pac-labs/ziprunner-spec/blob/v2.3.0/schemas/verification-report.schema.json",
  "title": "Consumer-observed verification result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "project",
    "version",
    "artifact_sha256",
    "plan_sha256",
    "generated_at",
    "environment",
    "build",
    "checks"
  ],
  "properties": {
    "schema": {
      "const": "ziprunner.verification-report/v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
      "maxLength": 120
    },
    "project": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "runner_id"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "runner_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
          "maxLength": 120
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "provenance"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "blocked",
            "not_run"
          ]
        },
        "provenance": {
          "const": "consumer_observed"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
            "maxLength": 120
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "blocked",
              "not_run"
            ]
          },
          "provenance": {
            "enum": [
              "consumer_observed",
              "operator_observed",
              "producer_reported"
            ]
          },
          "evidence": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reference",
                "sha256"
              ],
              "properties": {
                "reference": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "runner_ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
            "maxLength": 120
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
