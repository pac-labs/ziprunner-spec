{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pac-labs/ziprunner-spec/blob/v2.3.0/schemas/verification-plan.schema.json",
  "title": "ZipRunner functional verification plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "version",
    "tasks",
    "checks"
  ],
  "properties": {
    "schema": {
      "const": "ziprunner.verification-plan/v1"
    },
    "project": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 150,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "criteria"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
            "maxLength": 120
          },
          "criteria": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "description",
                "mode",
                "checks"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
                  "maxLength": 120
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "mode": {
                  "enum": [
                    "automated",
                    "manual",
                    "mixed"
                  ]
                },
                "checks": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 30,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
                    "maxLength": 120
                  }
                }
              }
            }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "stage",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
            "maxLength": 120
          },
          "kind": {
            "enum": [
              "automated",
              "manual"
            ]
          },
          "stage": {
            "enum": [
              "unit",
              "integration",
              "functional",
              "runtime",
              "acceptance"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "runner_ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
            "maxLength": 120
          },
          "assertions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "instructions": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "test_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    }
  }
}
