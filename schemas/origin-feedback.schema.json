{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pac-labs/ziprunner-spec/blob/v2.3.0/schemas/origin-feedback.schema.json",
  "title": "Consumer-owned origin feedback record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "message_id",
    "run_id",
    "project",
    "version",
    "artifact_sha256",
    "origin_request_id",
    "destination_binding",
    "summary",
    "delivery"
  ],
  "properties": {
    "schema": {
      "const": "ziprunner.origin-feedback/v1"
    },
    "message_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
      "maxLength": 120
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
      "maxLength": 120
    },
    "project": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "origin_request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
      "maxLength": 120
    },
    "destination_binding": {
      "enum": [
        "verified",
        "unresolved"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "checks": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
            "maxLength": 120
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "blocked",
              "not_run"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "maxItems": 150,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
            "maxLength": 120
          },
          "state": {
            "enum": [
              "awaiting_verification",
              "in_progress",
              "blocked",
              "todo",
              "done"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "attempts"
      ],
      "properties": {
        "state": {
          "enum": [
            "queued",
            "waiting_for_origin",
            "submitted",
            "acknowledged",
            "retryable_failure",
            "blocked"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "last_error": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "acknowledged_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
