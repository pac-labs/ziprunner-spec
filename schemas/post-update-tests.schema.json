{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ziprunner:spec:v1:post-update-tests.schema",
  "title": "Existing ZipRunner non-gating post-update test stamp",
  "type": "object",
  "required": [
    "schema",
    "version",
    "tests"
  ],
  "properties": {
    "schema": {
      "const": "ziprunner.post-update-tests.v1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "tests": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "semantic_id",
          "definition_revision"
        ],
        "properties": {
          "kind": {
            "enum": [
              "command",
              "manager_instruction"
            ]
          },
          "semantic_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
          },
          "definition_revision": {
            "type": [
              "string",
              "integer"
            ]
          },
          "rerun_policy": {
            "enum": [
              "every_update",
              "when_definition_changes"
            ]
          },
          "command": {
            "type": "string"
          },
          "instruction": {
            "type": "string"
          },
          "attention_on_failure": {
            "type": "boolean"
          },
          "gating": {
            "type": "boolean"
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1800
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
