{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ziprunner:spec:v1:ziprunner-manifest.schema",
  "title": "ZipRunner update work manifest v1",
  "type": "object",
  "required": [
    "schema",
    "spec_version",
    "project",
    "update",
    "planned_work",
    "done_work",
    "todo_work",
    "validation",
    "handover",
    "operator_actions",
    "release"
  ],
  "properties": {
    "schema": {
      "const": "ziprunner.update-manifest/v1"
    },
    "spec_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "project": {
      "type": "object",
      "required": [
        "key",
        "version"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "base_version": {
          "type": "string"
        },
        "source_revision": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "update": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "created_at",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
        },
        "kind": {
          "enum": [
            "source_update",
            "progress_update"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "planned_work": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "acceptance_criteria"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "acceptance_criteria": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "done_work": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "summary",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "kind",
                "ref",
                "description"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "source",
                    "test",
                    "log",
                    "diff",
                    "manual",
                    "review",
                    "documentation"
                  ]
                },
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "todo_work": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "next_action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
          },
          "status": {
            "enum": [
              "planned",
              "in_progress",
              "review",
              "blocked",
              "deferred"
            ]
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "plan_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "model_reported",
        "checks"
      ],
      "properties": {
        "model_reported": {
          "enum": [
            "passed",
            "partial",
            "failed",
            "not_run"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "status",
              "description"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "not_run",
                  "blocked"
                ]
              },
              "command": {
                "type": "string"
              },
              "environment": {
                "type": "string"
              },
              "evidence_ref": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "handover": {
      "type": "object",
      "required": [
        "next_pass",
        "risks",
        "blockers"
      ],
      "properties": {
        "next_pass": {
          "type": "string",
          "minLength": 1
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "operator_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "required",
              "optional",
              "not_required"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "release": {
      "type": "object",
      "required": [
        "requested",
        "requires_operator_approval"
      ],
      "properties": {
        "requested": {
          "type": "boolean"
        },
        "requires_operator_approval": {
          "const": true
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "conversation_url": {
          "type": "string",
          "format": "uri"
        },
        "model": {
          "type": "string"
        },
        "base_zip_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
